# Python Skill Lab local configuration.
# Copy this file to .env — it is auto-loaded by app.py at startup.
# Keys set in your shell environment take priority over this file.
# The app also writes API keys to .env automatically when you use
# Save & Apply or Verify provider in the AI Settings panel.

# Server
PY_SKILL_LAB_PORT=8765
PY_SKILL_LAB_OPEN_BROWSER=1
PY_SKILL_LAB_STRICT_CONTENT=0

# AI request timeouts, in seconds.
PY_SKILL_LAB_AI_TIMEOUT_SECONDS=45
PY_SKILL_LAB_AI_LOCAL_TIMEOUT_SECONDS=120
PY_SKILL_LAB_AI_MODELS_TIMEOUT_SECONDS=8

# AI provider keys — filled in automatically when you save settings in the app.
# You can also set these manually here before starting the app.
PY_SKILL_LAB_OPENAI_KEY=
PY_SKILL_LAB_ANTHROPIC_KEY=
PY_SKILL_LAB_GOOGLE_KEY=
PY_SKILL_LAB_GROK_KEY=
PY_SKILL_LAB_GROQ_KEY=
PY_SKILL_LAB_AZURE_FOUNDRY_KEY=

# Deprecated compatibility aliases. Prefer PY_SKILL_LAB_PORT and
# PY_SKILL_LAB_OPEN_BROWSER for new setups.
# PY_INTERVIEW_PORT=8765
# PY_INTERVIEW_OPEN_BROWSER=1
